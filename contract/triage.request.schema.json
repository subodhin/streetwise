{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Streetwise triage request",
  "type": "object",
  "required": [
    "id",
    "text",
    "lat",
    "lng",
    "reported_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 40
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lng": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "photo_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    }
  }
}
